# Copy to .env locally. Never commit real credentials.
PORT=3000
APP_ORIGIN=http://localhost:3000
# Demo access is loopback-only and forbidden in production.
DEMO_MODE=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# In Google Cloud set NODE_ENV=production and DEMO_MODE=false.
# Cloud SQL uses these fields via a mounted Cloud SQL Unix socket.
# PGHOST=/cloudsql/retrofitpathfinder:europe-west1:retrofit-db
# PGDATABASE=retrofit
# PGUSER=retrofit_app
# PGPASSWORD=from-secret-manager
# Or set DATABASE_URL for a local PostgreSQL instance with pgvector.
# DATABASE_URL=postgresql://user:password@localhost:5432/retrofit
# First boot only; remove bootstrap password after the admin is created.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# Set true only after reading the operator privacy documentation.
RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
